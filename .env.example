PORT=5000
DATABASE_URL="postgresql://postgres:password@localhost:5432/languageguru_db?schema=public"
# Generate a fresh one per environment, never reuse or commit a real value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="CHANGE_ME_generate_a_random_48_byte_secret"
FRONTEND_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"
NODE_ENV="development"

# ─── Admin seed (prisma/seed.ts) ────────────────────────────────────────────
# Optional. Used only by `npm run seed:admin`.
#   ADMIN_USERNAME  defaults to "admin"
#   ADMIN_NAME      defaults to "Super Admin"
#   ADMIN_PASSWORD  min 12 chars, with upper case, lower case and a number.
#                   Omit it and one is generated and printed once.
#   ADMIN_RESET     set to true to overwrite an EXISTING admin's password.
#                   Without it an existing account is never touched.
ADMIN_USERNAME=admin
ADMIN_NAME=Super Admin
# ADMIN_PASSWORD=
# ADMIN_RESET=false
