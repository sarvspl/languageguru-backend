# ─── Language Guru API ──────────────────────────────────────────────────────
# Copy this file to .env and fill in every value. The server validates all of
# them at boot and refuses to start if any is missing or still a placeholder.

# Required ───────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/languageguru_db?schema=public"

# Signs admin sessions. Generate a fresh one per environment, never reuse:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="CHANGE_ME_generate_a_random_48_byte_secret"

# CORS origins. Only these two (plus EXTRA_CORS_ORIGINS) are allowed to send
# credentialed requests — no host is trusted implicitly.
FRONTEND_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"

# Optional ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV="development"

# Interface to bind. Leave unset in development. Behind a reverse proxy set
# 127.0.0.1 so the port cannot be reached from the internet directly.
# HOST=127.0.0.1

# How many reverse proxies sit in front of this server (Express `trust proxy`).
# 0 = none. Behind one nginx set 1; add one per extra hop (e.g. Cloudflare -> 2).
# Required in production: without it every request looks like 127.0.0.1 and the
# login rate limiter throttles all visitors as a single client.
# TRUST_PROXY=1

# Comma-separated additional CORS origins, e.g. a staging domain.
# EXTRA_CORS_ORIGINS="https://staging.example.com"

# ─── Admin seed (npm run seed:admin) ───────────────────────────────────────
# Both are REQUIRED by the seed. Nothing is defaulted and nothing is generated.
# ADMIN_PASSWORD needs 12+ characters with upper case, lower case and a digit:
#   node -e "console.log(require('crypto').randomBytes(12).toString('base64url'))"
ADMIN_USERNAME="CHANGE_ME"
ADMIN_PASSWORD="CHANGE_ME"
# Optional display name; defaults to ADMIN_USERNAME.
# ADMIN_NAME="Super Admin"
# Set to true to overwrite an EXISTING account's password. Without it the seed
# never modifies an account that already exists.
# ADMIN_RESET=false
