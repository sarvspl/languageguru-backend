// ─── Universal page + section CMS ───────────────────────────────────────────
// SitePage gives every route an admin-editable slug, nav label and SEO block.
// `key` is the immutable identifier the code resolves against; `slug` is what
// appears in the URL and may be changed freely from the dashboard.
model SitePage {
  id            String        @id @default(uuid())
  key           String        @unique
  slug          String        @unique
  title         String
  navLabel      String?
  heroTag       String?
  heroTitle     String?
  heroSubtitle  String?
  heroImage     String?
  metaTitle     String?
  metaDesc      String?
  metaKeywords  String?
  ogImage       String?
  showInNav     Boolean       @default(false)
  showInFooter  Boolean       @default(false)
  showInSitemap Boolean       @default(true)
  isActive      Boolean       @default(true)
  sortOrder     Int           @default(0)
  sections      PageSection[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([slug])
}

// Every band of every page. `items` carries repeatable content — card grids,
// process steps, comparison rows, FAQ pairs, dropdown option lists — so a new
// kind of section needs no schema change.
model PageSection {
  id          String   @id @default(uuid())
  pageKey     String
  page        SitePage @relation(fields: [pageKey], references: [key], onDelete: Cascade)
  sectionKey  String
  kind        String   @default("richtext")
  tag         String?
  heading     String?
  subheading  String?
  body        String?
  layout      String   @default("text-only")
  imageUrl    String?
  buttonText  String?
  buttonLink  String?
  button2Text String?
  button2Link String?
  items       Json?
  settings    Json?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([pageKey, sectionKey])
  @@index([pageKey, sortOrder])
}
