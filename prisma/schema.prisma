generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id                String   @id @default(uuid())
  username          String   @unique
  passwordHash      String
  name              String?
  role              String   @default("ADMIN")
  passwordChangedAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Language {
  id               String   @id @default(uuid())
  key              String   @unique
  name             String
  flag             String
  native           String?
  cat              String?
  speakers         String?
  region           String?
  difficulty       String?
  script           String?
  price            Float?
  metaTitle        String?
  metaDesc         String?
  metaKeywords     String?
  ogImage          String?
  contentOverrides Json?
  faqs             Json?
  reviews          Json?
  pricing          Json?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model City {
  id               String   @id @default(uuid())
  key              String   @unique
  name             String
  ic               String?
  isMetro          Boolean  @default(false)
  state            String?
  metaTitle        String?
  metaDesc         String?
  // CMS-03: parity with Language and Service, whose detail pages were already
  // overridable. City detail pages had no CMS surface at all.
  contentOverrides Json?
  faqs             Json?
  reviews          Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  isActive         Boolean  @default(true)
}

model Service {
  id               String   @id @default(uuid())
  key              String   @unique
  name             String
  icon             String
  short            String?
  price            Float?
  fast             Int?
  label            String?
  tag              String?
  title            String?
  alt              Boolean?
  p1               String?
  p2               String?
  features         String[]
  docs             String[]
  ctaLabel         String?
  ctaKey           String?
  description      String?
  metaTitle        String?
  metaDesc         String?
  faqs             Json?
  reviews          Json?
  contentOverrides Json?
  certLang         String?
  certDoc          String?
  certFlag         String?
  certAcc          String?
  certTime         String?
  certIcon         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  isActive         Boolean  @default(true)
}

model QuoteRequest {
  id            String   @id @default(uuid())
  name          String
  email         String?
  phone         String
  serviceKey    String?
  sourceLang    String?
  targetLang    String?
  pages         Int      @default(1)
  isInterpreter Boolean  @default(false)
  notes         String?
  status        String   @default("PENDING") // PENDING, CONTACTED, IN_PROGRESS, COMPLETED, CANCELLED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model GalleryItem {
  id        String   @id @default(uuid())
  doc       String // Document type e.g. "Birth Certificate"
  lang      String // Language pair e.g. "English → German"
  flag      String // Flag emoji e.g. "🇩🇪"
  langKey   String? // language key e.g. "german"
  time      String? // Turnaround time e.g. "24 Hrs"
  icon      String? // Doc icon emoji e.g. "📜"
  seal      String? // Seal emoji e.g. "🇩🇪"
  acc       String? // Accepting authority e.g. "German Embassy"
  cat       String   @default("General") // Category for filtering
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Industry {
  id        String   @id @default(uuid())
  icon      String
  name      String   @unique
  desc      String
  svc       String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Translator {
  id        String   @id @default(uuid())
  name      String
  lang      String // Language e.g. "German"
  city      String // City e.g. "New Delhi"
  spec      String? // Specialization e.g. "Legal"
  exp       String? // Experience e.g. "8 years"
  rate      String? // Rate e.g. "₹899/pg"
  cert      String? // Certification e.g. "MA Translation"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

