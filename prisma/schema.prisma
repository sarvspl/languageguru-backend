model HomePageSection {
  id         String   @id @default(uuid())
  sectionId  String   @unique
  tag        String?
  title      String
  content    String
  imageUrl   String?
  layout     String   @default("image-right") // image-right, image-left, text-only
  buttonText String?
  buttonLink String?
  stat1Value String?
  stat1Label String?
  stat2Value String?
  stat2Label String?
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
